# Copy this file to .env and fill in your keys. Never commit .env.

NEBIUS_API_KEY=
TAVILY_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Models chosen in milestone 3 (see evals/model_selection.py).
# Prices are USD per 1M tokens; confirm them on the Token Factory prices page.
NEBIUS_MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_MODEL_FAST_USD_PER_M_INPUT=0.10
NEBIUS_MODEL_FAST_USD_PER_M_OUTPUT=0.30
NEBIUS_MODEL_STRONG=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_MODEL_STRONG_USD_PER_M_INPUT=0.20
NEBIUS_MODEL_STRONG_USD_PER_M_OUTPUT=0.60
NEBIUS_MODEL_BACKUP=deepseek-ai/DeepSeek-V4.1-Flash
NEBIUS_MODEL_BACKUP_USD_PER_M_INPUT=0.30
NEBIUS_MODEL_BACKUP_USD_PER_M_OUTPUT=1.20

# Per-run limits
# TAVILY_CREDIT_LIMIT=90
# NEBIUS_USD_LIMIT=0.50
